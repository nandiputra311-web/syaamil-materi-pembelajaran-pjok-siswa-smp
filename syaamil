    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Data Pertanyaan Kuis PJOK Tingkat SMP
        const quizDataSMP = [
            {
                question: "Dalam permainan bola basket, teknik tembakan melayang yang dilakukan melangkah 2 kali mendekati ring disebut...",
                options: ["Chest Pass", "Lay-up Shot", "Bound Pass", "Pivot"],
                correct: 1,
                explanation: "Tepat! Lay-up shot adalah tembakan melayang ke ring basket dengan tolakan satu kaki setelah melangkah 2 kali."
            },
            {
                question: "Pukulan keras menukik ke lapangan lawan dalam permainan bola voli yang bertujuan mematikan lawan disebut...",
                options: ["Passing bawah", "Service atas", "Smash / Spike", "Block"],
                correct: 2,
                explanation: "Benar! Smash (Spike) adalah pukulan keras dan menukik tajam ke arah pertahanan lawan."
            },
            {
                question: "Pada cabang atletik lari jarak pendek (sprint), teknik start yang wajib digunakan adalah...",
                options: ["Start Berdiri", "Start Melayang", "Start Jongkok", "Start Duduk"],
                correct: 2,
                explanation: "Hebat! Start Jongkok (crouch start) digunakan khusus untuk lari jarak pendek (100m, 200m, 400m)."
            },
            {
                question: "Cara memegang bet tenis meja seperti memegang pena / pulpen dikenal dengan istilah...",
                options: ["Shakehand Grip", "Penhold Grip", "Combination Grip", "Forehand Grip"],
                correct: 1,
                explanation: "Tepat sekali! Penhold Grip adalah teknik memegang bet seperti memegang pena."
            },
            {
                question: "Latihan otot yang paling efektif untuk melatih kekuatan otot dada dan lengan adalah...",
                options: ["Sit-up", "Push-up", "Back-up", "Jogging"],
                correct: 1,
                explanation: "Pintar! Push-up bertumpu pada lengan dan dada untuk meningkatkan kekuatan otot bagian atas."
            }
        ];

        let currentQuestionIndex = 0;
        let score = 0;
        let selectedOption = null;

        // Quiz DOM Elements
        const questionTextEl = document.getElementById('question-text');
        const optionsContainerEl = document.getElementById('options-container');
        const questionTrackerEl = document.getElementById('question-tracker');
        const currentScoreEl = document.getElementById('current-score');
        const progressBarEl = document.getElementById('progress-bar');
        const nextBtn = document.getElementById('next-btn');
        const feedbackBox = document.getElementById('feedback-box');
        
        const quizScreen = document.getElementById('quiz-screen');
        const resultScreen = document.getElementById('result-screen');
        const finalScoreEl = document.getElementById('final-score');
        const resultMessageEl = document.getElementById('result-message');
        const restartBtn = document.getElementById('restart-btn');

        // Search Filter Functionality
        const searchInput = document.getElementById('search-input');
        const sportCards = document.querySelectorAll('.sport-card');

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();
            sportCards.forEach(card => {
                const keywords = card.getAttribute('data-keywords').toLowerCase();
                const textContent = card.textContent.toLowerCase();
                if (keywords.includes(query) || textContent.includes(query)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        });

        // Mobile Nav Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Load Question Logic
        function loadQuestion() {
            const currentData = quizDataSMP[currentQuestionIndex];
            questionTextEl.textContent = `${currentQuestionIndex + 1}. ${currentData.question}`;
            questionTrackerEl.textContent = `Pertanyaan ${currentQuestionIndex + 1} dari ${quizDataSMP.length}`;
            
            // Update Progress Bar
            const progressPercent = ((currentQuestionIndex + 1) / quizDataSMP.length) * 100;
            progressBarEl.style.width = `${progressPercent}%`;

            // Reset UI states
            optionsContainerEl.innerHTML = '';
            feedbackBox.classList.add('hidden');
            nextBtn.classList.add('hidden');
            selectedOption = null;

            // Render options
            currentData.options.forEach((option, index) => {
                const btn = document.createElement('button');
                btn.className = `w-full text-left p-4 rounded-xl border-2 border-slate-200 hover:border-smpBlue hover:bg-blue-50/50 font-semibold text-slate-700 transition flex items-center justify-between text-sm option-btn`;
                btn.innerHTML = `
                    <span><strong class="text-smpBlue mr-2">${String.fromCharCode(65 + index)}.</strong> ${option}</span>
                    <i class="fa-regular fa-circle text-slate-300 status-icon"></i>
                `;
                btn.onclick = () => selectOption(index, btn);
                optionsContainerEl.appendChild(btn);
            });
        }

        // Handle Option Select
        function selectOption(index, button) {
            if (selectedOption !== null) return;
            selectedOption = index;

            const currentData = quizDataSMP[currentQuestionIndex];
            const allOptionBtns = optionsContainerEl.querySelectorAll('.option-btn');

            if (index === currentData.correct) {
                // Correct
                score += 20;
                currentScoreEl.textContent = score;
                button.classList.remove('border-slate-200', 'hover:bg-blue-50/50');
                button.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');
                button.querySelector('.status-icon').className = 'fa-solid fa-circle-check text-emerald-500 text-lg';

                feedbackBox.textContent = `🎯 ${currentData.explanation}`;
                feedbackBox.className = "p-4 rounded-2xl text-xs sm:text-sm font-semibold mb-6 bg-emerald-100/80 text-emerald-900 border border-emerald-300 block";
            } else {
                // Wrong
                button.classList.remove('border-slate-200', 'hover:bg-blue-50/50');
                button.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');
                button.querySelector('.status-icon').className = 'fa-solid fa-circle-xmark text-rose-500 text-lg';

                // Highlight Correct Option
                const correctBtn = allOptionBtns[currentData.correct];
                correctBtn.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');
                correctBtn.querySelector('.status-icon').className = 'fa-solid fa-circle-check text-emerald-500 text-lg';

                feedbackBox.textContent = `❌ ${currentData.explanation}`;
                feedbackBox.className = "p-4 rounded-2xl text-xs sm:text-sm font-semibold mb-6 bg-rose-100/80 text-rose-900 border border-rose-300 block";
            }

            nextBtn.classList.remove('hidden');
            allOptionBtns.forEach(btn => btn.style.pointerEvents = 'none');
        }

        // Next Button Action
        nextBtn.addEventListener('click', () => {
            currentQuestionIndex++;
            if (currentQuestionIndex < quizDataSMP.length) {
                loadQuestion();
            } else {
                showResults();
            }
        });

        // Show Results
        function showResults() {
            quizScreen.classList.add('hidden');
            resultScreen.classList.remove('hidden');
            finalScoreEl.textContent = score;

            if (score === 100) {
                resultMessageEl.textContent = "🔥 Sempurna! Kamu menguasai materi PJOK SMP dengan sangat baik!";
            } else if (score >= 60) {
                resultMessageEl.textContent = "👏 Bagus! Pemahaman materi olahragamu sudah cukup baik!";
            } else {
                resultMessageEl.textContent = "📚 Yuk pelajari lagi materi modul di atas dan coba kuis sekali lagi!";
            }
        }

        // Restart Quiz
        restartBtn.addEventListener('click', () => {
            currentQuestionIndex = 0;
            score = 0;
            currentScoreEl.textContent = 0;
            resultScreen.classList.add('hidden');
            quizScreen.classList.remove('hidden');
            loadQuestion();
        });

        // Initialize quiz on load
        window.onload = function() {
            loadQuestion();
        };
    </script>
